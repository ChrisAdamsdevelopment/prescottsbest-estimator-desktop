# PBC Estimator: COPY to .env on your own computer, never commit .env
AI_PORT=8787
AI_ACCESS_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google OAuth Desktop client for the operator, configured in Google Cloud:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# MCP write actions require explicit opt-in:
PBC_MCP_ENABLE_WRITES=0
PBC_PROJECT_ROOT=
PBC_VISUAL_ROOT=
# Leave the hosted portal unconfigured until a scoped operator account is granted:
PBC_PORTAL_URL=
PBC_PORTAL_ADMIN_KEY=
